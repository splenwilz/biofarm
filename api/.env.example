# Local development - copy to .env (never commit .env)
# DATABASE_URL defaults to sqlite+aiosqlite:///./dev.db when unset
BIOFARM_PIPEDRIVE_COMPANY_DOMAIN=
BIOFARM_PIPEDRIVE_API_TOKEN=
# Shared secret the marketing dashboard sends as x-dashboard-token to GET /v1/dashboard
# BIOFARM_DASHBOARD_TOKEN=
# Run the Pipedrive mirror import inside the web process every N minutes (0 = off; 15 on Render)
# BIOFARM_MIRROR_IMPORT_MINUTES=0
# BIOFARM_PIPEDRIVE_OWNER_ID=
# BIOFARM_PIPEDRIVE_OWNER_MAP={"contact:developer": 23328240, "contact:landowner": 27433044, "landowner": 27433044}
# BIOFARM_PIPEDRIVE_LEAD_LABEL_IDS=["uuid-here"]
# BIOFARM_PIPEDRIVE_LEAD_FIELD_MAP={"utm_source":"40charhash"}
# "Newsletter Sign Up" lead field: hash + option ids (Opted In / Opted Out), see api/README.md
# BIOFARM_PIPEDRIVE_NEWSLETTER_FIELD=
# BIOFARM_PIPEDRIVE_NEWSLETTER_OPTION_MAP={"opted_in": 1120, "opted_out": 1121}
# BIOFARM_GA4_MEASUREMENT_ID=G-3MS9TLLZRN
# BIOFARM_GA4_API_SECRET=
# "Website" option id of the Source channel deal field (1037 on the Biofarm account)
# BIOFARM_PIPEDRIVE_WEBSITE_CHANNEL=1037
# What counts as an enquiry on the dashboard (defaults in app/config.py; JSON values)
# BIOFARM_ENQUIRY_EXCLUDED_DEAL_ORIGINS=["Import"]
# BIOFARM_ENQUIRY_TEST_CAMPAIGNS=["tracking-test","go-live-check","field-map","final-check"]
# The team's own test domains and addresses (set these for real figures; a value replaces the default list)
# BIOFARM_ENQUIRY_TEST_DOMAINS=["biofarm-test.dev","your-company-domain.example"]
# BIOFARM_ENQUIRY_TEST_EMAILS=["you@example.com"]
# BIOFARM_ENQUIRY_STAFF_DOMAINS=["biofarm.co.uk"]
# BIOFARM_ENQUIRY_CHANNEL_BY_TITLE={"FBI":"Trade Show / Event"}
