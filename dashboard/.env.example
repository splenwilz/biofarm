# Server-side only (no NEXT_PUBLIC_ prefix): the lead API's dashboard feed.
# Leave both unset to run on demo data.
DASHBOARD_API_URL=
DASHBOARD_API_TOKEN=
# Company domain for the "open in Pipedrive" links on the Data quality page.
NEXT_PUBLIC_PIPEDRIVE_COMPANY_DOMAIN=

# Sign-in (required: without all three nobody can sign in, and /healthz says so).
# Two shared passwords, stored as scrypt hashes made with `npm run password-hash`,
# and a secret of 32+ characters that seals the session cookie (the same script
# prints one). Rotating a password = a new hash here and a redeploy.
DASHBOARD_PASSWORD_VIEW_HASH=
DASHBOARD_PASSWORD_ADMIN_HASH=
DASHBOARD_SESSION_SECRET=
